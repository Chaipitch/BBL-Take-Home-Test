generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// A person known to the API, provisioned on their first authenticated request.
/// Identity is the Auth0 `sub`; email is informational and only trusted for sharing when verified.
model User {
  id              String    @id @default(uuid(4)) @db.Uuid
  auth0Sub        String    @unique
  email           String?
  emailVerified   Boolean   @default(false)
  name            String?
  /// Last successful Auth0 /userinfo sync; null = never synced (ADR-009, ADR-011d).
  profileSyncedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collections  Collection[]
  bookmarks    Bookmark[]
  sharedWithMe CollectionShare[] @relation("SharedWithMe")

  @@index([email])
}

model Collection {
  id        String   @id @default(uuid(4)) @db.Uuid
  name      String   @db.VarChar(200)
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]
  shares    CollectionShare[]

  /// Target of Bookmark's composite FK: guarantees a bookmark can only point at its own owner's collection.
  @@unique([id, ownerId])
  @@index([ownerId, createdAt])
}

model Bookmark {
  id           String   @id @default(uuid(4)) @db.Uuid
  url          String   @db.VarChar(2048)
  title        String   @db.VarChar(500)
  notes        String?  @db.VarChar(10000)
  collectionId String?  @db.Uuid
  ownerId      String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Composite FK (collectionId, ownerId) -> Collection(id, ownerId). NULL collectionId = uncategorised
  /// (Postgres MATCH SIMPLE skips the check). Cascade per DECISIONS.md ADR-005.
  collection Collection? @relation(fields: [collectionId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([ownerId, collectionId])
}

/// Read-only grant of one collection to an existing user (DECISIONS.md ADR-006).
/// The owner names the recipient by email; the API resolves it to a registered user with a verified
/// email at share time and stores the user id, so access follows the account, not the address.
model CollectionShare {
  id            String   @id @default(uuid(4)) @db.Uuid
  collectionId  String   @db.Uuid
  granteeUserId String   @db.Uuid
  createdAt     DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  grantee    User       @relation("SharedWithMe", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@unique([collectionId, granteeUserId])
  @@index([granteeUserId])
}
